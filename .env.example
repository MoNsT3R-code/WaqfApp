# All settings are optional. No API keys are needed: the Help Center assistant and the
# Money Helper are RAG agents (LangChain + LangGraph) that run on this server.

# Base URL for the application endpoints.
# In production, set this to your public URL (e.g., https://ais-dev-jek7y35sapo4escerleyxq-745793448469.asia-southeast1.run.app)
# In local development, the server defaults to http://localhost:3000
APP_URL="https://ais-dev-jek7y35sapo4escerleyxq-745793448469.asia-southeast1.run.app"

# Server port (default 3000).
# PORT=3000

# Key for signing session tokens. Set a long random value in any shared deployment.
# JWT_SECRET="change-me"

# Local embedding model for FAQ retrieval (downloaded once from Hugging Face, then cached).
# EMBEDDINGS_MODEL="Xenova/paraphrase-multilingual-MiniLM-L12-v2"
# Where downloaded models are cached (default: ~/.cache/waqfapp/models).
# MODELS_CACHE_DIR=""

# Optional local language model via Ollama (https://ollama.com) for natural-language answers.
# Without it the agents answer by quoting the FAQ.
# OLLAMA_MODEL="llama3.2:3b"
# OLLAMA_BASE_URL="http://localhost:11434"
