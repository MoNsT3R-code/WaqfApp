# All settings are optional. No API keys are needed: the Help Center assistant and the
# Money Helper are RAG agents (LangChain + LangGraph) that run on this server.
# Copy this file to .env; the server reads it at start.

# Server port (default 3000). Vite's hot-reload socket uses PORT + 21678.
# PORT=3000

# Key for signing session tokens. Set a long random value in any shared deployment.
# JWT_SECRET="change-me"

# PIN that confirms transfers, Quick Loan and moves from savings (default 2580).
# WAQF_DEMO_PIN="2580"

# HMAC key for the hash-chained audit log. Without it a random key is made on each start.
# AUDIT_KEY="change-me"

# Where BreachMirror AI (github.com/MoNsT3R-code/BreachMirror-AI) is running.
# Run it on a different port from WaqfApp (both default to 3000).
# BREACHMIRROR_URL="http://localhost:3000"

# Local embedding model for FAQ retrieval (downloaded once from Hugging Face, then cached).
# EMBEDDINGS_MODEL="Xenova/paraphrase-multilingual-MiniLM-L12-v2"
# Where downloaded models are cached (default: ~/.cache/waqfapp/models).
# On Windows, use a short path if the model fails to load from a deep folder.
# MODELS_CACHE_DIR=""

# Optional local language model via Ollama (https://ollama.com) for natural-language answers.
# Without it the agents answer by quoting the FAQ.
# OLLAMA_MODEL="llama3.2:3b"
# OLLAMA_BASE_URL="http://localhost:11434"

# Set to "true" to turn off hot reload in development.
# DISABLE_HMR="false"
